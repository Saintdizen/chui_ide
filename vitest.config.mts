import { defineConfig } from 'vitest/config';

/**
 * Юнит-тесты чистой логики: то, что не требует Electron и DOM.
 * Проверки интерфейса и процессов живут в `scripts/*-smoke.cjs`.
 *
 * Вторая строка была неправдой до 24.10: тесты доходили до electron транзитом
 * (тест → `git/git.ts` → `git/exec.ts` → `app`), и прогон был зелён только
 * потому, что пакет лежал на диске. Без него 52 файла из 459 не загружаются и
 * 506 проверок из 5589 исчезают молча. Теперь electron подменён через alias.
 */
export default defineConfig({
  /**
   * Electron — на подделку, а не в `node_modules`. Зачем alias, а не `vi.mock`
   * в каждом файле: до electron доходят транзитом, и знать об этом пришлось бы
   * 52 файлам. См. `tests/mocks/electron.ts`.
   */
  resolve: {
    alias: {
      electron: new URL('./tests/mocks/electron.ts', import.meta.url).pathname,
    },
  },
  test: {
    environment: 'node',
    include: ['tests/**/*.test.ts'],
    /**
     * Изоляция модулей между файлами ОБЯЗАТЕЛЬНА.
     *
     * С `false` прогон вдвое быстрее (12 с против 39 с), но модули общие на
     * весь процесс: подмена `fs.watch` из одного файла протекает в соседние,
     * и тесты падают через раз — в зависимости от того, в каком порядке
     * vitest распределил файлы по воркерам (поймано на
     * `workspace-watch-retry.test.ts`: 4 теста зелёные в паре и красные
     * после восьми файлов). Плавающий прогон дороже 27 секунд.
     */
    isolate: true,
    reporters: ['default'],
    // Предел по умолчанию (5 с) мал для тестов, которые гоняют НАСТОЯЩИЙ git: на
    // Windows запуск каждого процесса стоит около секунды, и тест из десятка
    // вызовов упирается в предел не из-за ошибки, а из-за медленной машины. Предел
    // с запасом отделяет «долго» от «повисло»: настоящий зависон всё равно упрётся
    // в него, а честная работа на медленном раннере — нет.
    testTimeout: 30_000,
    hookTimeout: 30_000,
  },
  // Порог покрытия проверяется в `npm run check` (не отдельным шагом CI): иначе
  // сползание видно только через прогон, а пороги объявлены ради отсечки.
  // Уровни — на 2 пункта ниже достигнутого (79.95/74.43/77.21/82.59): запас оставлен,
  // чтобы сползание на процент не выдавало себя за случайное колебание.
  coverage: {
    provider: 'v8',
    reporter: ['text'],
    thresholds: { statements: 78, branches: 72.5, functions: 75, lines: 80.5 },
  },
});
