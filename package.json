{
  "name": "chui-ide",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "chui_iDE",
    "email": "chui-ide@users.noreply.github.com"
  },
  "description": "Редактор кода: Python и Node.js",
  "main": "dist/main/index.js",
  "desktopName": "chui-ide.desktop",
  "scripts": {
    "dev": "npm run build:main && node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.main.json && node scripts/bundle-preload.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json",
    "lint": "biome lint src scripts tests",
    "lint:fix": "biome lint --write src scripts tests",
    "format": "biome format --write src scripts tests",
    "format:check": "biome format src scripts tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm run test",
    "start": "npm run rebuild && npm run build && electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "smoke:pty": "ELECTRON_RUN_AS_NODE=1 electron scripts/pty-smoke.cjs",
    "smoke:terminal": "npm run build:main && electron scripts/terminal-smoke.cjs",
    "smoke:window": "npm run build:main && electron scripts/window-smoke.cjs",
    "clean": "rm -rf dist",
    "smoke:bridge": "npm run build:main && electron scripts/bridge-smoke.cjs",
    "smoke:mcp": "npm run build:main && node scripts/mcp-smoke.cjs",
    "smoke:ignore": "npm run build:main && electron scripts/ignore-smoke.cjs",
    "smoke:folder": "npm run build && node scripts/folder-smoke.cjs",
    "smoke:git": "npm run build:main && electron scripts/git-smoke.cjs",
    "smoke:agent": "npm run build:main && electron scripts/agent-smoke.cjs",
    "smoke:commitmsg": "npm run build:main && node scripts/commit-message-smoke.cjs",
    "smoke:browser": "npm run build:main && node scripts/browser-smoke.cjs",
    "smoke:sandbox": "npm run build:main && node scripts/sandbox-smoke.cjs",
    "smoke:map": "npm run build:main && electron scripts/project-map-smoke.cjs",
    "smoke:anthropic": "npm run build:main && node scripts/anthropic-smoke.cjs",
    "smoke:lsp": "npm run build:main && node scripts/lsp-smoke.cjs",
    "smoke:agent-terminal": "npm run build:main && node scripts/agent-terminal-smoke.cjs",
    "smoke:host": "npm run build:main && electron scripts/host-smoke.cjs",
    "smoke:edits": "tsc scripts/edits-check.ts --ignoreConfig --module commonjs --target es2020 --strict --outDir node_modules/.cache/edits-check && node node_modules/.cache/edits-check/scripts/edits-check.js",
    "smoke:launcher": "npm run build && electron scripts/launcher-smoke.cjs",
    "probe:colors": "electron scripts/color-probe.cjs",
    "probe:menu": "npm run build:main && electron scripts/menu-probe.cjs",
    "probe:popover": "npm run build && electron scripts/popover-probe.cjs",
    "probe:mcp": "npm run build && electron scripts/mcp-ui-probe.cjs",
    "probe:python": "npm run build && electron scripts/python-ui-probe.cjs",
    "probe:settings": "npm run build && electron scripts/settings-search-probe.cjs",
    "probe:palette": "npm run build && electron scripts/palette-probe.cjs",
    "probe:saveas": "npm run build && electron scripts/save-as-probe.cjs",
    "probe:hunkmenu": "npm run build && electron scripts/hunk-menu-probe.cjs",
    "probe:explorer": "npm run build && electron scripts/explorer-probe.cjs",
    "probe:tree": "npm run build && electron scripts/tree-virtual-probe.cjs",
    "probe:changes": "npm run build && electron scripts/changes-probe.cjs",
    "probe:folders": "npm run build && electron scripts/folders-probe.cjs",
    "probe:revert": "npm run build && electron scripts/revert-probe.cjs",
    "probe:sort": "npm run build && electron scripts/sort-probe.cjs",
    "probe:extterminal": "npm run build && electron scripts/ext-terminal-probe.cjs",
    "probe:editor": "electron scripts/own-editor-probe.cjs",
    "probe:lspbundled": "npm run build:main && electron scripts/lsp-bundled-probe.cjs",
    "probe:lspstatus": "npm run build && electron scripts/lsp-status-probe.cjs",
    "probe:lspstatus": "npm run build && electron scripts/lsp-status-probe.cjs",
    "probe:gitwatch": "npm run build:main && electron scripts/git-watch-probe.cjs",
    "probe:toolstate": "electron scripts/tool-state-probe.cjs",
    "probe:own-terminal": "electron scripts/own-terminal-probe.cjs",
    "probe:typing": "npm run build && electron scripts/type-probe.cjs",
    "probe:lsp": "npm run build && electron scripts/lsp-pickup-probe.cjs",
    "probe:cursor": "npm run build && bash scripts/cursor-probe.sh",
    "icon": "npm run build:main && node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "pyright": "^1.1.414",
    "typescript-bundled": "npm:typescript@^5.9.3",
    "typescript-language-server": "^6.0.2",
    "vscode-langservers-extracted": "^4.10.0",
    "yaml-language-server": "^1.25.0"
  }
}
