<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Права для вложенных процессов (вспомогательные бинарники Electron, нативные модули).

  Те же, что у приложения, плюс `com.apple.security.inherit`: вложенный процесс
  наследует права родителя, а не получает свои. Без этого файла вспомогательные
  процессы запускаются без нужных прав, и приложение падает не сразу, а при первом
  обращении к ним (например, к окну рендерера).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
